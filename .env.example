# EEW Discord Notify Environment Configuration

# Production Mode (true = Production, false = Sandbox Mode)
PRODUCTION=false

# Minimum Scale Threshold (-1 = Notify all events in Sandbox, 40 = Seismic Intensity 4+)
MIN_SCALE=-1

# Discord Webhook URL (Required)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL
